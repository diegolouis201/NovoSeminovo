{
  "name": "novoseminovo-app",
  "private": true,
  "description": "App Android e iOS do NovoSeminovo (Capacitor): abre o site e soma notificação, câmera, compartilhar e links. Fora do workspace pnpm de propósito, para não pesar no build do servidor.",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#FAF8F3' --splashBackgroundColor '#FAF8F3' --splashBackgroundColorDark '#0E2F4A'",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "typescript": "^5.6.3"
  }
}
