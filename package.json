{
  "name": "novoseminovo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @novoseminovo/db generate",
    "db:push": "pnpm --filter @novoseminovo/db push",
    "db:seed": "pnpm --filter @novoseminovo/db seed"
  },
  "devDependencies": {
    "modern-web-guidance": "1.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "lodash": "^4.18.1",
      "body-parser": "^1.20.9",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2"
    }
  }
}
