{
  "name": "novoseminovo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @novoseminovo/db generate",
    "db:push": "pnpm --filter @novoseminovo/db push",
    "db:seed": "pnpm --filter @novoseminovo/db seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
