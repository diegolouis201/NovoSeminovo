// Schema derivado da Etapa 2 (arquitetura de banco de dados) da conversa de planejamento.
// listings é a tabela polimórfica: todo anúncio (veículo ou imóvel) vive aqui;
// os campos específicos de cada vertical ficam em VehicleDetails/PropertyDetails (1:1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  buyer
  individual_seller
  partner_agent
  partner_owner
  admin
}

enum AuthProvider {
  email
  google
  apple
}

enum UserStatus {
  active
  suspended
}

enum PartnerType {
  dealership
  real_estate_agency
  broker
}

enum PartnerMemberRole {
  owner
  agent
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum ListingType {
  vehicle
  property
}

enum ListingStatus {
  draft
  pending_review
  active
  paused
  sold
  rejected
  expired
}

enum Transmission {
  manual
  automatic
}

enum FuelType {
  flex
  gasoline
  ethanol
  diesel
  electric
  hybrid
}

enum VehicleCondition {
  new
  used
}

enum PropertyType {
  house
  apartment
  land
  commercial
}

enum Purpose {
  sale
  rent
}

enum SimulationType {
  vehicle_cdc
  real_estate_financing
  rent
}

enum LeadSource {
  chat
  whatsapp
  phone
}

enum LeadStatus {
  new
  negotiating
  won
  lost
}

enum ReportStatus {
  open
  reviewed
  dismissed
}

enum ModerationAction {
  approved
  rejected
  suspended
}

// ---------- Core: users & partners ----------

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String?      @map("password_hash")
  authProvider AuthProvider @default(email) @map("auth_provider")
  role         Role         @default(buyer)
  avatarUrl    String?      @map("avatar_url")
  status       UserStatus   @default(active)
  createdAt    DateTime     @default(now()) @map("created_at")

  ownedPartners      Partner[]             @relation("PartnerOwner")
  partnerMemberships PartnerMember[]
  listings           Listing[]             @relation("ListingOwner")
  favorites          Favorite[]
  savedSearches      SavedSearch[]
  conversationsAsBuyer  Conversation[]      @relation("ConversationBuyer")
  conversationsAsSeller Conversation[]      @relation("ConversationSeller")
  messages           Message[]
  leadsAsBuyer       Lead[]
  simulations        FinancingSimulation[]
  reviewsWritten     Review[]              @relation("ReviewAuthor")
  reviewsReceived    Review[]              @relation("ReviewTarget")
  reports            Report[]
  moderationLogs     ModerationLog[]
  notifications      Notification[]

  @@map("users")
}

model Partner {
  id          String      @id @default(cuid())
  ownerUserId String      @map("owner_user_id")
  owner       User        @relation("PartnerOwner", fields: [ownerUserId], references: [id])
  type        PartnerType
  legalName   String      @map("legal_name")
  document    String
  verifiedAt  DateTime?   @map("verified_at")
  slug        String      @unique
  logoUrl     String?     @map("logo_url")
  description String?
  address     String?
  createdAt   DateTime    @default(now()) @map("created_at")

  members       PartnerMember[]
  listings      Listing[]
  subscriptions Subscription[]
  leads         Lead[]
  reviews       Review[]        @relation("ReviewPartnerTarget")

  @@map("partners")
}

model PartnerMember {
  id        String            @id @default(cuid())
  partnerId String            @map("partner_id")
  partner   Partner           @relation(fields: [partnerId], references: [id])
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id])
  role      PartnerMemberRole

  @@unique([partnerId, userId])
  @@map("partner_members")
}

// ---------- Plans & subscriptions ----------

model Plan {
  id                 String   @id @default(cuid())
  name               String
  maxActiveListings  Int      @map("max_active_listings")
  highlightCredits   Int      @default(0) @map("highlight_credits")
  priceMonth         Decimal  @map("price_month") @db.Decimal(10, 2)
  features           Json     @default("{}")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  partnerId          String             @map("partner_id")
  partner            Partner            @relation(fields: [partnerId], references: [id])
  planId             String             @map("plan_id")
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  paymentProviderRef String?            @map("payment_provider_ref")

  @@map("subscriptions")
}

// ---------- Listings (polimórfico) ----------

model Listing {
  id               String        @id @default(cuid())
  type             ListingType
  ownerUserId      String        @map("owner_user_id")
  owner            User          @relation("ListingOwner", fields: [ownerUserId], references: [id])
  partnerId        String?       @map("partner_id")
  partner          Partner?      @relation(fields: [partnerId], references: [id])
  title            String
  description      String
  price            Decimal       @db.Decimal(12, 2)
  currency         String        @default("BRL")
  status           ListingStatus @default(draft)
  city             String
  state            String
  neighborhood     String?
  lat              Float?
  lng              Float?
  coverPhotoId     String?       @map("cover_photo_id")
  viewsCount       Int           @default(0) @map("views_count")
  highlightedUntil DateTime?     @map("highlighted_until")
  publishedAt      DateTime?     @map("published_at")
  expiresAt        DateTime?     @map("expires_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  vehicleDetails VehicleDetails?
  propertyDetails PropertyDetails?
  photos         Photo[]
  favorites      Favorite[]
  conversations  Conversation[]
  leads          Lead[]
  reports        Report[]
  simulations    FinancingSimulation[]
  reviews        Review[]
  moderationLogs ModerationLog[]

  @@index([type, status, city, price])
  @@map("listings")
}

model VehicleDetails {
  listingId       String            @id @map("listing_id")
  listing         Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  brandId         String            @map("brand_id")
  brand           VehicleBrand      @relation(fields: [brandId], references: [id])
  modelId         String            @map("model_id")
  model           VehicleModel      @relation(fields: [modelId], references: [id])
  version         String?
  yearManufacture Int               @map("year_manufacture")
  yearModel       Int               @map("year_model")
  mileage         Int
  transmission    Transmission
  fuelType        FuelType          @map("fuel_type")
  color           String
  doors           Int?
  plateHash       String            @map("plate_hash")
  fipeCode        String?           @map("fipe_code")
  fipePrice       Decimal?          @map("fipe_price") @db.Decimal(12, 2)
  condition       VehicleCondition  @default(used)

  @@index([brandId, modelId, yearModel])
  @@map("vehicle_details")
}

model PropertyDetails {
  listingId          String       @id @map("listing_id")
  listing            Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  propertyType        PropertyType @map("property_type")
  purpose             Purpose
  bedrooms            Int?
  bathrooms           Int?
  parkingSpots         Int?        @map("parking_spots")
  areaM2               Decimal     @map("area_m2") @db.Decimal(8, 2)
  condoFee            Decimal?     @map("condo_fee") @db.Decimal(10, 2)
  iptu                Decimal?     @db.Decimal(10, 2)
  streetAddress       String       @map("street_address")
  registrationNumber  String?      @map("registration_number")

  @@index([propertyType, purpose, bedrooms, areaM2])
  @@map("property_details")
}

model VehicleBrand {
  id      String           @id @default(cuid())
  name    String           @unique
  models  VehicleModel[]
  details VehicleDetails[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id      String           @id @default(cuid())
  brandId String           @map("brand_id")
  brand   VehicleBrand     @relation(fields: [brandId], references: [id])
  name    String
  details VehicleDetails[]

  @@unique([brandId, name])
  @@map("vehicle_models")
}

model Photo {
  id           String  @id @default(cuid())
  listingId    String  @map("listing_id")
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url          String
  position     Int     @default(0)
  isCover      Boolean @default(false) @map("is_cover")
  qualityScore Int?    @map("quality_score") // reservado para IA de validação de fotos (Fase 2)

  @@index([listingId])
  @@map("photos")
}

// ---------- Engagement ----------

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, listingId])
  @@map("favorites")
}

model SavedSearch {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  type          ListingType
  filters       Json
  alertEnabled  Boolean     @default(true) @map("alert_enabled")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_searches")
}

model Conversation {
  id             String    @id @default(cuid())
  listingId      String    @map("listing_id")
  listing        Listing   @relation(fields: [listingId], references: [id])
  buyerId        String    @map("buyer_id")
  buyer          User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  sellerUserId   String?   @map("seller_user_id")
  sellerUser     User?     @relation("ConversationSeller", fields: [sellerUserId], references: [id])
  lastMessageAt  DateTime? @map("last_message_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model Lead {
  id        String     @id @default(cuid())
  listingId String     @map("listing_id")
  listing   Listing    @relation(fields: [listingId], references: [id])
  partnerId String     @map("partner_id")
  partner   Partner    @relation(fields: [partnerId], references: [id])
  buyerId   String?    @map("buyer_id")
  buyer     User?      @relation(fields: [buyerId], references: [id])
  source    LeadSource
  status    LeadStatus @default(new)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([partnerId, status])
  @@map("leads")
}

model FinancingSimulation {
  id           String          @id @default(cuid())
  listingId    String          @map("listing_id")
  listing      Listing         @relation(fields: [listingId], references: [id])
  userId       String?         @map("user_id")
  user         User?           @relation(fields: [userId], references: [id])
  simType      SimulationType  @map("sim_type")
  downPayment  Decimal         @map("down_payment") @db.Decimal(12, 2)
  installments Int
  estimatedRate Decimal        @map("estimated_rate") @db.Decimal(5, 2)
  result       Json
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("financing_simulations")
}

model Review {
  id                String   @id @default(cuid())
  reviewerId        String   @map("reviewer_id")
  reviewer          User     @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewedUserId    String?  @map("reviewed_user_id")
  reviewedUser      User?    @relation("ReviewTarget", fields: [reviewedUserId], references: [id])
  reviewedPartnerId String?  @map("reviewed_partner_id")
  reviewedPartner   Partner? @relation("ReviewPartnerTarget", fields: [reviewedPartnerId], references: [id])
  listingId         String?  @map("listing_id")
  listing           Listing? @relation(fields: [listingId], references: [id])
  rating            Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Report {
  id         String       @id @default(cuid())
  listingId  String       @map("listing_id")
  listing    Listing      @relation(fields: [listingId], references: [id])
  reporterId String       @map("reporter_id")
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("reports")
}

model ModerationLog {
  id        String            @id @default(cuid())
  listingId String            @map("listing_id")
  listing   Listing           @relation(fields: [listingId], references: [id])
  adminId   String            @map("admin_id")
  admin     User              @relation(fields: [adminId], references: [id])
  action    ModerationAction
  reason    String?
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("moderation_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}
