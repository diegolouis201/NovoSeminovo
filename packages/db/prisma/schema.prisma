// Schema derivado da Etapa 2 (arquitetura de banco de dados) da conversa de planejamento.
// listings é a tabela polimórfica: todo anúncio (veículo ou imóvel) vive aqui;
// os campos específicos de cada vertical ficam em VehicleDetails/PropertyDetails (1:1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  buyer
  individual_seller
  partner_agent
  partner_owner
  admin
}

enum AuthProvider {
  email
  google
  apple
}

enum UserStatus {
  active
  suspended
}

enum Gender {
  male
  female
  other
  undisclosed
}

enum PartnerType {
  dealership
  real_estate_agency
  broker
  workshop
  builder
}

enum PartnerMemberRole {
  owner
  agent
}

enum FinancingDealStatus {
  registered
  paid
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

enum ListingType {
  vehicle
  property
}

enum ListingStatus {
  draft
  pending_review
  active
  paused
  sold
  rejected
  expired
}

enum Transmission {
  manual
  automatic
}

enum FuelType {
  flex
  gasoline
  ethanol
  diesel
  electric
  hybrid
}

enum VehicleCondition {
  new
  used
}

enum PropertyType {
  house
  apartment
  land
  commercial
  penthouse
  farm
  warehouse
  condo_house
  studio
  store
  garage
}

enum Purpose {
  sale
  rent
}

enum SimulationType {
  vehicle_cdc
  real_estate_financing
  rent
}

enum LeadSource {
  chat
  whatsapp
  phone
  // Cadastrados à mão no kanban do parceiro (cliente que foi à loja,
  // indicação, Instagram…).
  walk_in
  referral
  social
  other
}

// Funil do lead no kanban do parceiro. "negotiating" = proposta/negociando.
enum LeadStatus {
  new
  contacted
  visit_scheduled
  negotiating
  won
  lost
}

enum ReportStatus {
  open
  reviewed
  dismissed
}

enum ModerationAction {
  approved
  rejected
  suspended
}

enum VehicleEventType {
  ownership_change
  revision
  repair
  accident
  inspection
  listing_published
  other
}

enum VehicleEventSource {
  owner_reported
  partner_verified
  system
}

// ---------- Core: users & partners ----------

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String?      @map("password_hash")
  authProvider AuthProvider @default(email) @map("auth_provider")
  role         Role         @default(buyer)
  avatarUrl    String?      @map("avatar_url")
  status       UserStatus   @default(active)
  createdAt    DateTime     @default(now()) @map("created_at")

  // Perfil completo (ver tela "Minha conta") — tudo opcional porque o
  // cadastro inicial continua mínimo (nome/e-mail/senha); CPF em especial é
  // o que falta pra poder pagar o rebate de PF via Pix (ver RebatesService).
  cpf       String?   @unique
  gender    Gender?
  birthDate DateTime? @map("birth_date")
  zipCode   String?   @map("zip_code")
  state     String?
  city      String?

  // Verificação de e-mail por código (ver EmailVerificationService) —
  // emailVerifiedAt nulo até a pessoa confirmar o código mandado pro
  // próprio e-mail cadastrado.
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationCode      String?   @map("email_verification_code")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")

  ownedPartners            Partner[]             @relation("PartnerOwner")
  partnerMemberships       PartnerMember[]
  listings                 Listing[]             @relation("ListingOwner")
  favorites                Favorite[]
  savedSearches            SavedSearch[]
  conversationsAsBuyer     Conversation[]        @relation("ConversationBuyer")
  conversationsAsSeller    Conversation[]        @relation("ConversationSeller")
  messages                 Message[]
  leadsAsBuyer             Lead[]
  simulations              FinancingSimulation[]
  reviewsWritten           Review[]              @relation("ReviewAuthor")
  reviewsReceived          Review[]              @relation("ReviewTarget")
  reports                  Report[]
  moderationLogs           ModerationLog[]
  notifications            Notification[]
  vehiclesOwned            Vehicle[]             @relation("VehicleCurrentOwner")
  vehicleEvents            VehicleEvent[]
  financingDealsRegistered FinancingDeal[]       @relation("FinancingDealRegisteredBy")
  agentConversations       AgentConversation[]

  // Programa de afiliados: a conta de afiliado desta pessoa (se ela se
  // inscreveu) e quem a indicou (link ?ref= ou código no cadastro).
  affiliate             Affiliate?
  referredByAffiliateId String?            @map("referred_by_affiliate_id")
  referredByAffiliate   Affiliate?         @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id])
  referredAt            DateTime?          @map("referred_at")
  // Origem do cadastro (ver ACQUISITION_* em shared-types): google, instagram, afiliado…
  acqSource             String?            @map("acq_source")
  acqMedium             String?            @map("acq_medium")
  acqCampaign           String?            @map("acq_campaign")
  architectSessions     ArchitectSession[]

  @@map("users")
}

model Partner {
  id                 String      @id @default(cuid())
  ownerUserId        String      @map("owner_user_id")
  owner              User        @relation("PartnerOwner", fields: [ownerUserId], references: [id])
  type               PartnerType
  legalName          String      @map("legal_name")
  document           String
  verifiedAt         DateTime?   @map("verified_at")
  slug               String      @unique
  logoUrl            String?     @map("logo_url")
  description        String?
  address            String?
  // Reaproveitado entre tentativas de checkout — sem isso, cada contratação
  // criaria um Customer novo no Stripe pra mesma loja.
  stripeCustomerId   String?     @map("stripe_customer_id")
  // Anotações internas da equipe no quadro de assinaturas (/admin/assinaturas)
  // — nunca aparece pro parceiro.
  adminNotes         String?     @map("admin_notes")
  // Aviso de "faltam 7 dias pro fim do período grátis" já enviado (uma vez só).
  trialWarningSentAt DateTime?   @map("trial_warning_sent_at")
  createdAt          DateTime    @default(now()) @map("created_at")

  members               PartnerMember[]
  listings              Listing[]
  subscriptions         Subscription[]
  leads                 Lead[]
  reviews               Review[]          @relation("ReviewPartnerTarget")
  verifiedVehicleEvents VehicleEvent[]
  integrationFeeds      IntegrationFeed[]
  apiKeys               PartnerApiKey[]

  @@map("partners")
}

model PartnerMember {
  id        String            @id @default(cuid())
  partnerId String            @map("partner_id")
  partner   Partner           @relation(fields: [partnerId], references: [id])
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id])
  role      PartnerMemberRole

  @@unique([partnerId, userId])
  @@map("partner_members")
}

// ---------- Plans & subscriptions ----------

model Plan {
  id                    String  @id @default(cuid())
  name                  String
  maxActiveListings     Int     @map("max_active_listings")
  highlightCredits      Int     @default(0) @map("highlight_credits")
  // Super destaque (topo da busca, junto do Nitro) — packs de imobiliária.
  superHighlightCredits Int     @default(0) @map("super_highlight_credits")
  priceMonth            Decimal @map("price_month") @db.Decimal(10, 2)
  features              Json    @default("{}")
  // Price de teste criado via API (ver PaymentsService.ensureStripeCatalog)
  // na primeira vez que o servidor sobe com STRIPE_SECRET_KEY configurado —
  // nulo enquanto não tiver chave nenhuma, aí "contratar" cai na simulação.
  stripePriceId         String? @map("stripe_price_id")
  // Pra quem é o plano: "vehicle" (loja de veículos) ou "property"
  // (imobiliária/corretor). Os planos de loja de veículos vêm do catálogo
  // em código (ver PartnersService.ensurePlanCatalog).
  audience              String?
  active                Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

// Compra de plano de anúncio (pessoa física, pagamento único — ver
// ListingsService.startBoost). status: pending → paid.
model ListingBoostPurchase {
  id              String    @id @default(cuid())
  listingId       String    @map("listing_id")
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId          String    @map("user_id")
  tier            String
  amount          Decimal   @db.Decimal(10, 2)
  stripeSessionId String?   @unique @map("stripe_session_id")
  status          String    @default("pending")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status, paidAt])
  @@map("listing_boost_purchases")
}

model Subscription {
  id                 String             @id @default(cuid())
  partnerId          String             @map("partner_id")
  partner            Partner            @relation(fields: [partnerId], references: [id])
  planId             String             @map("plan_id")
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  paymentProviderRef String?            @map("payment_provider_ref")
  // Quando o status mudou pela última vez (ativou, atrasou, cancelou) — base
  // dos "dias na etapa" e dos cancelamentos do mês no quadro do admin.
  statusChangedAt    DateTime           @default(now()) @map("status_changed_at")

  @@map("subscriptions")
}

// ---------- Listings (polimórfico) ----------

model Listing {
  id               String        @id @default(cuid())
  type             ListingType
  ownerUserId      String        @map("owner_user_id")
  owner            User          @relation("ListingOwner", fields: [ownerUserId], references: [id])
  partnerId        String?       @map("partner_id")
  partner          Partner?      @relation(fields: [partnerId], references: [id])
  title            String
  description      String
  price            Decimal       @db.Decimal(12, 2)
  currency         String        @default("BRL")
  status           ListingStatus @default(draft)
  city             String
  state            String
  neighborhood     String?
  // Coordenada do endereço (geocodificado no servidor — ver GeocodingService).
  // É a exata: nunca sai da API assim; o mapa recebe um ponto aproximado
  // (approximatePoint no mapper), porque o endereço completo é privado.
  latitude         Float?
  longitude        Float?
  geocodedAt       DateTime?     @map("geocoded_at")
  lat              Float?
  lng              Float?
  coverPhotoId     String?       @map("cover_photo_id")
  viewsCount       Int           @default(0) @map("views_count")
  highlightedUntil DateTime?     @map("highlighted_until")
  publishedAt      DateTime?     @map("published_at")
  // Escolhas do vendedor no cadastro em passo a passo: vídeo do YouTube,
  // mostrar ou não a simulação/contato de financiamento e o botão de WhatsApp.
  videoUrl         String?       @map("video_url")
  // Plano do anúncio de pessoa física (ver LISTING_TIERS no shared-types):
  // "free" | "flex" | "turbo" | "nitro". tierRank é o número usado na
  // ordenação da busca (nitro=3 no topo). Só muda depois do pagamento.
  planTier         String        @default("free") @map("plan_tier")
  tierRank         Int           @default(0) @map("tier_rank")
  financingEnabled Boolean       @default(true) @map("financing_enabled")
  showPhone        Boolean       @default(true) @map("show_phone")
  expiresAt        DateTime?     @map("expires_at")
  // Preenchidos só na transição pra "sold" (ver ListingsService.updateStatus)
  // — soldPrice pode diferir do price anunciado (negociação), por isso é
  // capturado à parte em vez de reaproveitar price pro relatório de vendas.
  soldAt           DateTime?     @map("sold_at")
  soldPrice        Decimal?      @map("sold_price") @db.Decimal(12, 2)
  // Quanto o bem custou pra loja (compra + preparação) — com o soldPrice dá
  // o lucro da venda em /parceiro/vendas. Informado pela loja, opcional.
  costPrice        Decimal?      @map("cost_price") @db.Decimal(12, 2)
  // Anúncio que veio do CRM do parceiro (ver IntegrationsService): de onde
  // ("feed:<id do feed>" ou "api") e o código do imóvel/veículo lá no CRM —
  // é o que liga a próxima sincronização ao mesmo anúncio em vez de criar
  // um duplicado. externalHash é o retrato do último conteúdo importado, pra
  // pular sem tocar no banco o que não mudou. syncPaused marca o anúncio que
  // Pausado pelo sistema por falta de plano (fim do período grátis, plano
  // cancelado ou trocado por um menor) — volta sozinho quando a loja assinar.
  pausedByPlan     Boolean       @default(false) @map("paused_by_plan")
  // a sincronização pausou porque sumiu do CRM — só esses ela reativa
  // sozinha se voltarem (um pausado à mão pelo dono continua pausado).
  externalSource   String?       @map("external_source")
  externalId       String?       @map("external_id")
  externalHash     String?       @map("external_hash")
  syncPaused       Boolean       @default(false) @map("sync_paused")
  // Moderação automática (ver AutoModerationService): quando a IA olhou o
  // anúncio e, se deixou pra revisão humana, o porquê (aparece no /admin).
  autoReviewedAt   DateTime?     @map("auto_reviewed_at")
  autoReviewNote   String?       @map("auto_review_note")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  vehicleDetails    VehicleDetails?
  propertyDetails   PropertyDetails?
  photos            Photo[]
  architectSessions ArchitectSession[]
  boostPurchases    ListingBoostPurchase[]
  favorites         Favorite[]
  conversations     Conversation[]
  leads             Lead[]
  reports           Report[]
  simulations       FinancingSimulation[]
  reviews           Review[]
  moderationLogs    ModerationLog[]
  financingDeals    FinancingDeal[]
  financingLeads    FinancingLead[]

  @@unique([partnerId, externalId])
  @@index([type, status, city, price])
  @@map("listings")
}

model VehicleDetails {
  listingId       String           @id @map("listing_id")
  listing         Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  brandId         String           @map("brand_id")
  brand           VehicleBrand     @relation(fields: [brandId], references: [id])
  modelId         String           @map("model_id")
  model           VehicleModel     @relation(fields: [modelId], references: [id])
  version         String?
  yearManufacture Int              @map("year_manufacture")
  yearModel       Int              @map("year_model")
  mileage         Int
  transmission    Transmission
  fuelType        FuelType         @map("fuel_type")
  color           String
  doors           Int?
  fipeCode        String?          @map("fipe_code")
  fipePrice       Decimal?         @map("fipe_price") @db.Decimal(12, 2)
  condition       VehicleCondition @default(used)
  // Opcionais e condições (ver VEHICLE_FEATURE_OPTIONS/VEHICLE_CONDITION_OPTIONS
  // no shared-types) — viram filtro na busca.
  features        String[]         @default([])
  conditions      String[]         @default([])
  // Carroceria, direção e motor (ver VEHICLE_BODY_TYPE_OPTIONS etc. no
  // shared-types) — opcionais porque anúncios antigos/CRM não têm.
  bodyType        String?          @map("body_type")
  steering        String?
  engine          String?
  // Ligação com o "prontuário" do carro de verdade (ver Vehicle abaixo) —
  // opcional porque a pessoa pode não informar a placa ao anunciar; sem
  // placa, não dá pra saber com certeza que é o mesmo carro de um anúncio
  // anterior, então o anúncio fica sem histórico em vez de criar um Vehicle
  // "órfão" que nunca vai casar com nada.
  vehicleId       String?          @map("vehicle_id")
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])

  @@index([brandId, modelId, yearModel])
  @@map("vehicle_details")
}

// O "Ativo" do carro, separado do anúncio: um Corolla pode passar por três
// donos e seis anúncios ao longo da vida, mas é um Vehicle só, identificado
// pela placa (normalizada e com hash — nunca guardamos a placa em texto
// puro, só um hash pra comparar "é o mesmo carro?" e uma versão mascarada
// pra exibir). Ver VehiclesService.resolveForListing: anúncio novo com a
// mesma placa de um Vehicle existente vira um evento no histórico dele, em
// vez de um registro novo do zero.
model Vehicle {
  id              String        @id @default(cuid())
  plateHash       String?       @unique @map("plate_hash")
  plateMasked     String?       @map("plate_masked")
  brandId         String?       @map("brand_id")
  brand           VehicleBrand? @relation(fields: [brandId], references: [id])
  modelId         String?       @map("model_id")
  model           VehicleModel? @relation(fields: [modelId], references: [id])
  yearManufacture Int?          @map("year_manufacture")
  yearModel       Int?          @map("year_model")
  color           String?
  currentOwnerId  String?       @map("current_owner_id")
  currentOwner    User?         @relation("VehicleCurrentOwner", fields: [currentOwnerId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  listings VehicleDetails[]
  events   VehicleEvent[]

  @@map("vehicles")
}

// Uma linha da timeline do Vehicle ("prontuário"). ownership_change e
// listing_published nunca são criados pelo próprio usuário via API (ver
// CreateVehicleEventInputSchema) — só o backend gera esses dois, pra não
// virarem algo que o dono forja sobre si mesmo. revision/repair/inspection/
// other são autoanunciados (source=owner_reported) até existir parceiro
// verificado (oficina, despachante) alimentando isso de verdade.
model VehicleEvent {
  id                  String             @id @default(cuid())
  vehicleId           String             @map("vehicle_id")
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type                VehicleEventType
  source              VehicleEventSource @default(owner_reported)
  title               String
  description         String?
  mileageAtEvent      Int?               @map("mileage_at_event")
  occurredAt          DateTime           @map("occurred_at")
  // Comprovante (nota fiscal, ordem de serviço, foto do serviço) — exigido
  // pra registrar qualquer evento autoanunciado (ver VehiclesController.addEvent),
  // pra não virar um campo de texto livre sem nenhuma prova por trás.
  photoUrls           String[]           @default([]) @map("photo_urls")
  createdByUserId     String?            @map("created_by_user_id")
  createdByUser       User?              @relation(fields: [createdByUserId], references: [id])
  createdAt           DateTime           @default(now()) @map("created_at")
  // Oficina marcada pelo dono como responsável pelo serviço — enquanto
  // source continuar "owner_reported", é uma confirmação pendente; quando a
  // própria oficina confirma (ver VehiclesService.confirmService), source
  // vira "partner_verified" e este campo passa a dizer quem verificou.
  verifiedByPartnerId String?            @map("verified_by_partner_id")
  verifiedByPartner   Partner?           @relation(fields: [verifiedByPartnerId], references: [id])

  @@index([vehicleId, occurredAt])
  @@map("vehicle_events")
}

model PropertyDetails {
  listingId          String       @id @map("listing_id")
  listing            Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  propertyType       PropertyType @map("property_type")
  purpose            Purpose
  bedrooms           Int?
  suites             Int?
  bathrooms          Int?
  parkingSpots       Int?         @map("parking_spots")
  floor              Int?
  areaM2             Decimal      @map("area_m2") @db.Decimal(8, 2)
  // Área total do terreno — distinta da área construída/útil acima (ex.:
  // casa com quintal, sítio, terreno puro). Opcional: só faz sentido
  // informar quando o imóvel tem terreno além da área construída.
  totalAreaM2        Decimal?     @map("total_area_m2") @db.Decimal(10, 2)
  condoFee           Decimal?     @map("condo_fee") @db.Decimal(10, 2)
  iptu               Decimal?     @db.Decimal(10, 2)
  // Diferenciais soltos (piscina, varanda, churrasqueira, elevador, área
  // gourmet, jardim etc.) — lista livre em vez de uma coluna booleana por
  // item, pra não exigir migração toda vez que surgir um diferencial novo.
  features           String[]     @default([])
  streetAddress      String       @map("street_address")
  registrationNumber String?      @map("registration_number")

  @@index([propertyType, purpose, bedrooms, areaM2])
  @@map("property_details")
}

model VehicleBrand {
  id       String           @id @default(cuid())
  name     String           @unique
  models   VehicleModel[]
  details  VehicleDetails[]
  vehicles Vehicle[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id       String           @id @default(cuid())
  brandId  String           @map("brand_id")
  brand    VehicleBrand     @relation(fields: [brandId], references: [id])
  name     String
  details  VehicleDetails[]
  vehicles Vehicle[]

  @@unique([brandId, name])
  @@map("vehicle_models")
}

model Photo {
  id           String  @id @default(cuid())
  listingId    String  @map("listing_id")
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url          String
  position     Int     @default(0)
  isCover      Boolean @default(false) @map("is_cover")
  qualityScore Int?    @map("quality_score") // reservado para IA de validação de fotos (Fase 2)
  // Legenda sugerida pela IA ao classificar/ordenar o lote de fotos (ver
  // AiService.classifyVehiclePhotos) — editável pelo dono na galeria.
  caption      String?

  @@index([listingId])
  @@map("photos")
}

// ---------- Engagement ----------

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, listingId])
  @@map("favorites")
}

model SavedSearch {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id])
  type         ListingType
  filters      Json
  alertEnabled Boolean     @default(true) @map("alert_enabled")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_searches")
}

model Conversation {
  id            String    @id @default(cuid())
  listingId     String    @map("listing_id")
  listing       Listing   @relation(fields: [listingId], references: [id])
  buyerId       String    @map("buyer_id")
  buyer         User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  sellerUserId  String?   @map("seller_user_id")
  sellerUser    User?     @relation("ConversationSeller", fields: [sellerUserId], references: [id])
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model Lead {
  id              String     @id @default(cuid())
  // Opcional: lead cadastrado à mão pode ser "procura SUV até 80 mil", sem
  // anúncio específico.
  listingId       String?    @map("listing_id")
  listing         Listing?   @relation(fields: [listingId], references: [id])
  partnerId       String     @map("partner_id")
  partner         Partner    @relation(fields: [partnerId], references: [id])
  buyerId         String?    @map("buyer_id")
  buyer           User?      @relation(fields: [buyerId], references: [id])
  source          LeadSource
  status          LeadStatus @default(new)
  // Lead manual (sem conta no site): nome e telefone digitados pela loja.
  contactName     String?    @map("contact_name")
  contactPhone    String?    @map("contact_phone")
  notes           String?
  proposalValue   Decimal?   @map("proposal_value") @db.Decimal(12, 2)
  // Origem de quem gerou o lead (cookie do site ou cadastro do comprador).
  acqSource       String?    @map("acq_source")
  acqCampaign     String?    @map("acq_campaign")
  statusChangedAt DateTime   @default(now()) @map("status_changed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([partnerId, status])
  @@map("leads")
}

model FinancingSimulation {
  id            String         @id @default(cuid())
  listingId     String         @map("listing_id")
  listing       Listing        @relation(fields: [listingId], references: [id])
  userId        String?        @map("user_id")
  user          User?          @relation(fields: [userId], references: [id])
  simType       SimulationType @map("sim_type")
  downPayment   Decimal        @map("down_payment") @db.Decimal(12, 2)
  installments  Int
  estimatedRate Decimal        @map("estimated_rate") @db.Decimal(5, 2)
  result        Json
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("financing_simulations")
}

model Review {
  id                String   @id @default(cuid())
  reviewerId        String   @map("reviewer_id")
  reviewer          User     @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewedUserId    String?  @map("reviewed_user_id")
  reviewedUser      User?    @relation("ReviewTarget", fields: [reviewedUserId], references: [id])
  reviewedPartnerId String?  @map("reviewed_partner_id")
  reviewedPartner   Partner? @relation("ReviewPartnerTarget", fields: [reviewedPartnerId], references: [id])
  listingId         String?  @map("listing_id")
  listing           Listing? @relation(fields: [listingId], references: [id])
  rating            Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Report {
  id         String       @id @default(cuid())
  listingId  String       @map("listing_id")
  listing    Listing      @relation(fields: [listingId], references: [id])
  reporterId String       @map("reporter_id")
  reporter   User         @relation(fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("reports")
}

model ModerationLog {
  id        String           @id @default(cuid())
  listingId String           @map("listing_id")
  listing   Listing          @relation(fields: [listingId], references: [id])
  // Vazio quando quem decidiu foi a moderação automática (automated).
  adminId   String?          @map("admin_id")
  admin     User?            @relation(fields: [adminId], references: [id])
  automated Boolean          @default(false)
  action    ModerationAction
  reason    String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("moderation_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

// ---------- Programa de recompensa por financiamento ----------
// Quando o comprador de um anúncio fecha financiamento (imobiliário ou
// veicular) por um parceiro financeiro, uma parte da comissão do correspondente
// bancário volta pra quem anunciou — PF ganha uma fatia fixa; corretor/
// imobiliária e lojista evoluem de nível conforme o volume financiado
// acumulado em negócios vindos da plataforma (ver PartnerRebateTier, editável
// pelo admin sem precisar mexer em código). Ainda não há integração em tempo
// real com nenhum parceiro financeiro — por isso o negócio fechado é
// registrado manualmente pelo admin (ver RebatesService).
model PartnerRebateTier {
  id            String      @id @default(cuid())
  partnerType   PartnerType @map("partner_type")
  tierOrder     Int         @map("tier_order")
  tierName      String      @map("tier_name")
  // Volume financiado acumulado (histórico) a partir do qual o parceiro
  // passa a receber esse percentual.
  minVolume     Decimal     @map("min_volume") @db.Decimal(14, 2)
  rebatePercent Decimal     @map("rebate_percent") @db.Decimal(5, 2)

  @@unique([partnerType, tierOrder])
  @@map("partner_rebate_tiers")
}

model FinancingDeal {
  id                 String              @id @default(cuid())
  listingId          String              @map("listing_id")
  listing            Listing             @relation(fields: [listingId], references: [id])
  // Nome livre (não um enum fechado) porque o programa não é exclusivo da
  // Credihome — qualquer parceiro de financiamento futuro usa o mesmo fluxo.
  financingProvider  String              @map("financing_provider")
  externalRef        String?             @map("external_ref")
  assetValue         Decimal             @map("asset_value") @db.Decimal(12, 2)
  financedAmount     Decimal             @map("financed_amount") @db.Decimal(12, 2)
  commissionRate     Decimal             @default(1.00) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount   Decimal             @map("commission_amount") @db.Decimal(12, 2)
  // Percentual e valor do rebate são um retrato de quando o negócio foi
  // registrado — o nível de um parceiro pode mudar depois, mas isso não deve
  // alterar o valor de um negócio já fechado.
  rebatePercent      Decimal             @map("rebate_percent") @db.Decimal(5, 2)
  rebateAmount       Decimal             @map("rebate_amount") @db.Decimal(12, 2)
  status             FinancingDealStatus @default(registered)
  registeredByUserId String              @map("registered_by_user_id")
  registeredBy       User                @relation("FinancingDealRegisteredBy", fields: [registeredByUserId], references: [id])
  paidAt             DateTime?           @map("paid_at")
  paidNote           String?             @map("paid_note")
  createdAt          DateTime            @default(now()) @map("created_at")
  financingLead      FinancingLead?

  @@index([status])
  @@map("financing_deals")
}

// ---------- Agentes de IA ----------

// Cada agente atende um público diferente (comprador no site/WhatsApp,
// lojista/corretor no painel, admin) — mesma engine (ver AgentsService), só
// muda o prompt e as ferramentas que o modelo pode chamar.
enum AgentKind {
  buyer
  partner
  admin
}

enum AgentChannel {
  web
  whatsapp
}

// Histórico guardado como o array de mensagens da API da Anthropic, do jeito
// que volta pro modelo na próxima rodada — nunca editado à mão, só
// acrescentado pelo AgentsService. externalId é o telefone no canal WhatsApp
// (uma conversa contínua por número), vazio no site.
model AgentConversation {
  id          String       @id @default(cuid())
  kind        AgentKind
  channel     AgentChannel @default(web)
  userId      String?      @map("user_id")
  user        User?        @relation(fields: [userId], references: [id])
  externalId  String?      @map("external_id")
  messages    Json         @default("[]")
  turnCount   Int          @default(0) @map("turn_count")
  acqSource   String?      @map("acq_source")
  acqCampaign String?      @map("acq_campaign")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  financingLeads FinancingLead[]

  @@unique([kind, channel, externalId])
  @@index([userId])
  @@map("agent_conversations")
}

// Etapas do funil do correspondente bancário (quadro em /admin/financiamentos).
// "converted" é a etapa final (Concluído — contrato assinado/liberado); o
// nome ficou do primeiro modelo, que só tinha novo/contato/fechado/perdido —
// mantido pra não perder o andamento dos leads já gravados. Imóvel passa
// por property_appraisal (vistoria/avaliação de engenharia do banco);
// veículo pula essa etapa.
enum FinancingLeadStatus {
  new
  contacted
  documents
  credit_analysis
  approved
  property_appraisal
  contract
  converted
  lost
}

// Interessado em financiamento captado pelo agente comprador — é o lead do
// corban (Diego), diferente de Lead, que é o contato de um comprador com o
// parceiro dono do anúncio. Vira FinancingDeal (manual, pelo admin) se o
// financiamento fechar.
model FinancingLead {
  id              String              @id @default(cuid())
  conversationId  String?             @map("conversation_id")
  conversation    AgentConversation?  @relation(fields: [conversationId], references: [id])
  listingId       String?             @map("listing_id")
  listing         Listing?            @relation(fields: [listingId], references: [id])
  channel         AgentChannel
  name            String
  phone           String
  email           String?
  assetType       String              @map("asset_type")
  assetValue      Decimal?            @map("asset_value") @db.Decimal(12, 2)
  downPayment     Decimal?            @map("down_payment") @db.Decimal(12, 2)
  monthlyIncome   Decimal?            @map("monthly_income") @db.Decimal(12, 2)
  // Resumo escrito pelo assistente de compra na hora do pedido.
  notes           String?
  status          FinancingLeadStatus @default(new)
  // Preenchidos pelo admin conforme a negociação anda: valor que vai ser
  // financiado de fato, banco, percentual de comissão do correspondente
  // (padrão 1%, igual ao FinancingDeal) e anotações próprias.
  negotiatedValue Decimal?            @map("negotiated_value") @db.Decimal(12, 2)
  acqSource       String?             @map("acq_source")
  acqCampaign     String?             @map("acq_campaign")
  commissionRate  Decimal             @default(1.00) @map("commission_rate") @db.Decimal(5, 2)
  bank            String?
  adminNotes      String?             @map("admin_notes")
  statusChangedAt DateTime?           @map("status_changed_at")
  // Negócio registrado automaticamente quando o lead é concluído (ver
  // AgentsService.updateFinancingLead) — é o que entra no fechamento mensal
  // e no repasse ao anunciante (ver RebatesService).
  financingDealId String?             @unique @map("financing_deal_id")
  financingDeal   FinancingDeal?      @relation(fields: [financingDealId], references: [id])
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@map("financing_leads")
}

// ---------- Integração com CRMs ----------

enum IntegrationFeedFormat {
  // Padrão VRSync (Grupo ZAP/VivaReal/OLX) — o que praticamente todo CRM
  // imobiliário brasileiro já exporta pros portais.
  vrsync
  // Catálogo de veículos no padrão Meta (Facebook/Instagram) — XML ou CSV,
  // com os nomes de campo do Google Vehicle Ads também aceitos. É o link de
  // estoque que os sistemas de loja de veículos mais costumam gerar.
  meta_vehicles
  // Formato próprio do NovoSeminovo (JSON, veículo e imóvel) — documentado
  // em /parceiro/integracoes/api, pra CRM/integrador que não tem VRSync.
  novoseminovo_json
}

enum IntegrationSyncStatus {
  never
  running
  ok
  error
}

// Link de feed que o CRM do parceiro gera. A API baixa e sincroniza
// periodicamente (ver IntegrationsScheduler) e quando o parceiro pede.
model IntegrationFeed {
  id         String                @id @default(cuid())
  partnerId  String                @map("partner_id")
  partner    Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  url        String
  format     IntegrationFeedFormat
  active     Boolean               @default(true)
  lastSyncAt DateTime?             @map("last_sync_at")
  lastStatus IntegrationSyncStatus @default(never) @map("last_status")
  lastError  String?               @map("last_error")
  // Relatório da última sincronização (criados/atualizados/pausados/erros
  // por item) — mostrado no painel pro parceiro entender o que aconteceu.
  lastReport Json?                 @map("last_report")
  createdAt  DateTime              @default(now()) @map("created_at")

  @@index([active, lastSyncAt])
  @@map("integration_feeds")
}

// Chave da API de integração (push em tempo real pelo CRM). Só o hash fica
// no banco — a chave em si aparece uma única vez, na hora de criar.
model PartnerApiKey {
  id              String    @id @default(cuid())
  partnerId       String    @map("partner_id")
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name            String
  prefix          String
  keyHash         String    @unique @map("key_hash")
  createdByUserId String    @map("created_by_user_id")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([partnerId])
  @@map("partner_api_keys")
}

// ---------- Arquiteto NovoSeminovo (IA de reforma, ver apps/api/src/architect) ----------

// Uma conversa por pessoa + anúncio de imóvel (retomada se voltar). messages
// no formato da API da Anthropic, sem as fotos em base64 (trocadas por texto
// antes de salvar); shoppingList = última lista de compras montada pela IA.
model ArchitectSession {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String           @map("listing_id")
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages     Json             @default("[]")
  shoppingList Json?            @map("shopping_list")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  images       ArchitectImage[]
  clicks       AffiliateClick[]

  @@index([userId, listingId])
  @@map("architect_sessions")
}

// Imagem de "depois da reforma" gerada a partir de uma foto do anúncio. Conta
// no limite diário por pessoa (ARCHITECT_DAILY_IMAGES).
model ArchitectImage {
  id           String           @id @default(cuid())
  sessionId    String           @map("session_id")
  session      ArchitectSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String           @map("user_id")
  photoId      String?          @map("photo_id")
  sourceUrl    String           @map("source_url")
  instructions String
  resultUrl    String           @map("result_url")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("architect_images")
}

// Clique num link de loja da lista de compras — base pra negociar comissão
// com lojas/programas de afiliados.
model AffiliateClick {
  id        String            @id @default(cuid())
  sessionId String?           @map("session_id")
  session   ArchitectSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String?           @map("user_id")
  store     String
  query     String
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("affiliate_clicks")
}

// Programa de afiliados (influenciadores, criadores, parceiros comerciais):
// indicam pelo link novoseminovo.com.br/?ref=CODIGO ou pelo código digitado
// no cadastro, e ganham comissão sobre o que os indicados pagam (ver
// AffiliatesService e AFFILIATE_RULES no shared-types).
model Affiliate {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  code       String    @unique
  // pending → approved | rejected; approved → suspended (e volta).
  status     String    @default("pending")
  channels   String
  audience   String?
  pixKey     String    @map("pix_key")
  adminNote  String?   @map("admin_note")
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  referrals   User[]                @relation("AffiliateReferrals")
  commissions AffiliateCommission[]
  clicks      AffiliateClickDay[]

  @@index([status])
  @@map("affiliates")
}

// Cliques no link do afiliado, somados por dia (não uma linha por clique).
model AffiliateClickDay {
  affiliateId String    @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  day         String
  count       Int       @default(0)

  @@id([affiliateId, day])
  @@map("affiliate_click_days")
}

// Uma comissão por pagamento do indicado. sourceRef é o id do pagamento
// (fatura do Stripe ou compra do plano do anúncio) — único, então um evento
// repetido do Stripe nunca paga duas vezes.
model AffiliateCommission {
  id             String    @id @default(cuid())
  affiliateId    String    @map("affiliate_id")
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])
  // "partner_subscription" (mensalidade de loja/imobiliária) | "listing_plan" (plano de anúncio de PF)
  source         String
  sourceRef      String    @unique @map("source_ref")
  referredUserId String    @map("referred_user_id")
  partnerId      String?   @map("partner_id")
  description    String
  baseAmount     Decimal   @map("base_amount") @db.Decimal(12, 2)
  rate           Decimal   @db.Decimal(5, 2)
  amount         Decimal   @db.Decimal(12, 2)
  // pending (período de garantia contra estorno) → available → paid; canceled se estornar.
  status         String    @default("pending")
  availableAt    DateTime  @map("available_at")
  paidAt         DateTime? @map("paid_at")
  paidNote       String?   @map("paid_note")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([affiliateId, status])
  @@index([partnerId])
  @@map("affiliate_commissions")
}

// Cada mensalidade paga de loja/imobiliária (webhook invoice.paid do Stripe):
// receita real por mês no painel geral do admin.
model SubscriptionPayment {
  id              String   @id @default(cuid())
  stripeInvoiceId String   @unique @map("stripe_invoice_id")
  partnerId       String   @map("partner_id")
  partnerType     String   @map("partner_type")
  amount          Decimal  @db.Decimal(12, 2)
  paidAt          DateTime @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([paidAt])
  @@map("subscription_payments")
}

// Comissão das lojas parceiras (Amazon, Mercado Livre…) lançada à mão pelo
// admin a partir do relatório de cada programa — um valor por loja por mês.
model StoreEarning {
  id        String   @id @default(cuid())
  month     String
  store     String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([month, store])
  @@map("store_earnings")
}

// ---------------------------------------------------------------------------
// Operação com agentes de IA (Fase 1 — núcleo). Ver docs/agentes-ia.md.
// ---------------------------------------------------------------------------

// Tarefa de um agente. status: pending → running → completed, com as saídas
// awaiting_approval, blocked, failed e cancelled. dedupeKey impede que a mesma
// rotina (ex.: "kpi-snapshot:2026-10-25") seja enfileirada duas vezes.
model AgentTask {
  id           String           @id @default(cuid())
  agent        String
  createdBy    String           @map("created_by")
  objective    String
  segment      String           @default("all")
  input        Json?
  priority     Int              @default(5)
  status       String           @default("pending")
  result       Json?
  error        String?
  attempts     Int              @default(0)
  maxAttempts  Int              @default(3) @map("max_attempts")
  runAfter     DateTime         @default(now()) @map("run_after")
  lockedAt     DateTime?        @map("locked_at")
  deadline     DateTime?
  dedupeKey    String?          @unique @map("dedupe_key")
  costLimitBrl Decimal?         @map("cost_limit_brl") @db.Decimal(10, 2)
  parentId     String?          @map("parent_id")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  events       AgentTaskEvent[]
  approvals    AgentApproval[]

  @@index([status, runAfter])
  @@index([agent, createdAt])
  @@map("agent_tasks")
}

// Histórico da tarefa: só se acrescenta, nunca se edita.
model AgentTaskEvent {
  id        String    @id @default(cuid())
  taskId    String    @map("task_id")
  task      AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  message   String
  data      Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("agent_task_events")
}

// Pedido de aprovação de uma ação amarela. paramsHash = assinatura da ação
// exata: se os parâmetros mudarem depois, a aprovação não vale.
model AgentApproval {
  id           String     @id @default(cuid())
  taskId       String?    @map("task_id")
  task         AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agent        String
  tool         String
  params       Json
  paramsHash   String     @map("params_hash")
  summary      String
  impact       String?
  reason       String?
  costBrl      Decimal?   @map("cost_brl") @db.Decimal(10, 2)
  // pending → approved → executed | failed; ou rejected / expired
  status       String     @default("pending")
  expiresAt    DateTime   @map("expires_at")
  decidedById  String?    @map("decided_by_id")
  decidedAt    DateTime?  @map("decided_at")
  decisionNote String?    @map("decision_note")
  executedAt   DateTime?  @map("executed_at")
  result       Json?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("agent_approvals")
}

// Cada chamada aos modelos Claude (de qualquer uso de IA do site): tokens e custo.
model AgentRun {
  id               String   @id @default(cuid())
  feature          String
  taskId           String?  @map("task_id")
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  costUsd          Decimal  @map("cost_usd") @db.Decimal(12, 6)
  costBrl          Decimal  @map("cost_brl") @db.Decimal(12, 4)
  durationMs       Int?     @map("duration_ms")
  error            String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([feature, createdAt])
  @@map("agent_runs")
}

// Meta de um indicador num período ("2026-11"), por segmento.
model AgentGoal {
  id        String   @id @default(cuid())
  metric    String
  segment   String   @default("all")
  period    String
  target    Decimal  @db.Decimal(14, 2)
  agent     String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([metric, segment, period])
  @@map("agent_goals")
}

// Foto diária dos números do painel geral, por recorte (all / vehicle / property).
model KpiSnapshot {
  id        String   @id @default(cuid())
  day       String
  scope     String
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([day, scope])
  @@map("kpi_snapshots")
}

// Batimento de cada rotina automática da API: o monitor avisa o admin quando
// uma delas para de rodar ou começa a falhar.
model RoutineHeartbeat {
  name        String    @id
  intervalMs  Int       @map("interval_ms")
  lastRunAt   DateTime  @map("last_run_at")
  lastOkAt    DateTime? @map("last_ok_at")
  lastError   String?   @map("last_error")
  failures    Int       @default(0)
  lastAlertAt DateTime? @map("last_alert_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("routine_heartbeats")
}
