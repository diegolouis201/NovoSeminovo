PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/novoseminovo?schema=public"
WEB_ORIGIN="http://localhost:3000"

# Assina os JWTs devolvidos por POST /auth/login. Gere com: openssl rand -base64 33
JWT_SECRET="troque-por-um-segredo-gerado-localmente"

# Fotos de anúncio: sem nada abaixo, salva em disco local (apps/api/uploads/,
# ver common/storage.ts) — funciona pra rodar local/demo, mas não sobrevive a
# um redeploy sem volume persistente. Configure S3_BUCKET pra usar S3 ou um
# bucket R2 (compatível com a API do S3) em produção; os outros ficam
# obrigatórios só quando S3_BUCKET está definido.
# S3_BUCKET="meu-bucket-novoseminovo"
# S3_PUBLIC_URL_BASE="https://pub-xxxxxxxx.r2.dev"        # obrigatório com S3_BUCKET
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"  # R2 ou outro S3-compatível; vazio = AWS S3 de verdade
# S3_REGION="auto"                                        # "auto" serve pro R2; na AWS use a região do bucket
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="true"                              # alguns provedores S3-compatíveis precisam disso
# S3_ACL="public-read"                                    # só se o bucket exigir ACL por objeto (R2 geralmente não)

# Plano do parceiro: sem nada abaixo, "contratar" em /parceiro/plano é uma
# simulação (ativa a assinatura na hora, sem cobrar nada — ver
# PartnersService.subscribe). Configure STRIPE_SECRET_KEY pra passar a abrir
# um checkout de verdade (em modo de teste, se a chave for sk_test_...) —
# PaymentsService.ensureStripeCatalog cria os Products/Prices sozinho na
# primeira vez que alguém contrata, sem precisar mexer no dashboard.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."                        # obrigatório pra POST /webhooks/stripe verificar a assinatura

# E-mail: sem nada abaixo, notificação (ver NotificationsService.notify) e
# alerta de busca salva (ver SavedSearchesService.notifyMatches) existem só
# dentro do site — nenhum e-mail sai. Configure RESEND_API_KEY pra também
# mandar uma cópia por e-mail de cada notificação criada. Conta grátis em
# resend.com, sem precisar verificar domínio pra mandar pro próprio e-mail
# da conta (remetente compartilhado onboarding@resend.dev).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="NovoSeminovo <onboarding@resend.dev>"        # opcional — sem isso usa esse mesmo remetente de teste

# IA no anúncio (Fase 3: gerar anúncio a partir de texto livre, sugestão de
# preço por IA — ver AiService). Sem isso, essa funcionalidade fica
# desativada no site (mesmo padrão de STRIPE_SECRET_KEY/RESEND_API_KEY).
# Gere em console.anthropic.com → Chaves de API.
# ANTHROPIC_API_KEY="sk-ant-..."

# Agentes de IA (ver apps/api/src/agents/) — usam a mesma ANTHROPIC_API_KEY
# acima; sem ela o botão "Assistente" simplesmente não aparece no site.
# AGENT_HUMAN_WHATSAPP="5531936187896"   # WhatsApp que o agente passa quando a pessoa pede um humano
# AGENT_DAILY_MESSAGE_LIMIT="3000"       # teto diário de mensagens somando todos os agentes (controle de custo)

# Integração com CRMs (ver apps/api/src/integrations/) — funciona sem nada
# configurado. Intervalo da sincronização automática dos feeds (mínimo 15).
# INTEGRATION_SYNC_INTERVAL_MINUTES="60"

# WhatsApp do Agente Comprador (WhatsApp Cloud API da Meta — ver
# apps/api/src/agents/whatsapp.service.ts). Sem as 4 primeiras, o canal fica
# desligado. Webhook pra cadastrar no app da Meta: https://api.SEU_DOMINIO/webhooks/whatsapp
# WHATSAPP_TOKEN="EAA..."                 # token permanente (usuário do sistema)
# WHATSAPP_PHONE_NUMBER_ID="1234567890"   # "Identificação do número de telefone" no painel
# WHATSAPP_VERIFY_TOKEN="um-texto-qualquer-que-voce-inventar"
# WHATSAPP_APP_SECRET="..."               # Configurações do app → Básico → Chave secreta do app
# WHATSAPP_GRAPH_VERSION="v23.0"          # opcional — use a versão que o painel mostrar

# Arquiteto NovoSeminovo (IA de reforma) — imagens pelo Google Gemini (aistudio.google.com → Get API key)
# GEMINI_API_KEY="..."
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"   # opcional
# ARCHITECT_DAILY_IMAGES="5"                    # imagens por cliente por dia
# AUTO_MODERATION_DISABLED="1"                 # desliga a moderação automática de anúncios (IA)
# Links de afiliado da lista de compras (opcional — sem eles os links funcionam, só sem comissão)
# AFFILIATE_AMAZON_TAG="novoseminovo-20"
# AFFILIATE_MAGALU_STORE="magazinenovoseminovo"
# AFFILIATE_MERCADOLIVRE_QUERY=""
# AFFILIATE_LEROYMERLIN_QUERY=""
