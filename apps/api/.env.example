PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/novoseminovo?schema=public"
WEB_ORIGIN="http://localhost:3000"

# Assina os JWTs devolvidos por POST /auth/login. Gere com: openssl rand -base64 33
JWT_SECRET="troque-por-um-segredo-gerado-localmente"

# Fotos de anúncio: sem nada abaixo, salva em disco local (apps/api/uploads/,
# ver common/storage.ts) — funciona pra rodar local/demo, mas não sobrevive a
# um redeploy sem volume persistente. Configure S3_BUCKET pra usar S3 ou um
# bucket R2 (compatível com a API do S3) em produção; os outros ficam
# obrigatórios só quando S3_BUCKET está definido.
# S3_BUCKET="meu-bucket-novoseminovo"
# S3_PUBLIC_URL_BASE="https://pub-xxxxxxxx.r2.dev"        # obrigatório com S3_BUCKET
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"  # R2 ou outro S3-compatível; vazio = AWS S3 de verdade
# S3_REGION="auto"                                        # "auto" serve pro R2; na AWS use a região do bucket
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="true"                              # alguns provedores S3-compatíveis precisam disso
# S3_ACL="public-read"                                    # só se o bucket exigir ACL por objeto (R2 geralmente não)
