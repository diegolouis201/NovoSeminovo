{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "cypress",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": false,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "**/*.ts",
    "../cypress.config.ts"
  ]
}
