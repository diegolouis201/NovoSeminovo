# Copie pra ".env" na mesma pasta do docker-compose.yml, no servidor —
# "docker compose" lê esse arquivo sozinho. Nunca comite o ".env" de
# verdade (já está no .gitignore).

# Seu domínio, sem "https://" e sem "www." (ex.: novoseminovo.com.br).
# O site fica em {DOMAIN}, a API em api.{DOMAIN} — os dois precisam
# apontar (registro A) pro IP deste servidor antes de subir o Caddy,
# senão a emissão automática do certificado HTTPS falha.
DOMAIN=seudominio.com.br

# Gere os três com: openssl rand -hex 32
# POSTGRES_PASSWORD entra numa URL de conexão (postgresql://user:SENHA@...) —
# use hex (0-9a-f), nunca base64: "/", "+" ou "=" no meio da senha quebram
# essa URL e a API recusa subir com "invalid port number in database URL".
POSTGRES_PASSWORD=
JWT_SECRET=
AUTH_SECRET=

# Opcionais — vazios, cada integração cai pro modo simulado de sempre
# (ver README "Próximos passos" e apps/api/.env.example pro que cada uma faz)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
S3_BUCKET=
S3_PUBLIC_URL_BASE=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# WhatsApp do assistente de compra (WhatsApp Cloud API da Meta). Deixe em
# branco até ter as credenciais — o canal fica desligado sem elas.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
