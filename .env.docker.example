# Copie pra ".env" na mesma pasta do docker-compose.yml, no servidor —
# "docker compose" lê esse arquivo sozinho. Nunca comite o ".env" de
# verdade (já está no .gitignore).

# Seu domínio, sem "https://" e sem "www." (ex.: novoseminovo.com.br).
# O site fica em {DOMAIN}, a API em api.{DOMAIN} — os dois precisam
# apontar (registro A) pro IP deste servidor antes de subir o Caddy,
# senão a emissão automática do certificado HTTPS falha.
DOMAIN=seudominio.com.br

# Gere os três com: openssl rand -base64 33
POSTGRES_PASSWORD=
JWT_SECRET=
AUTH_SECRET=

# Opcionais — vazios, cada integração cai pro modo simulado de sempre
# (ver README "Próximos passos" e apps/api/.env.example pro que cada uma faz)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
S3_BUCKET=
S3_PUBLIC_URL_BASE=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
